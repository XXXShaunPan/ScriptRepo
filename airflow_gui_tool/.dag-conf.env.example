# DAG trigger form field mapping.
# Each item maps one DAG to a structured form. DAGs not listed here keep the raw JSON conf box.
# You can also host this file publicly and set DAG_CONF_ENV_URL in .env.
DAG_CONF_FIELD_MAPPING=[
  {
    "dag_name": "ads_credit_moniter",
    "keys": ["location"],
    "alias": ["站点"],
    "tips": ["对应 conf.location，可填写单个站点或脚本约定的站点值"]
  }
]
