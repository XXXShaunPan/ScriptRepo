# Airflow GUI Tool
# AIRFLOW_LIST is a JSON array. Add more Airflow services as additional objects.
# Every service id must be unique; it is used as the dropdown value and state key.
AIRFLOW_LIST=[{"id":"main","alias":"Shaun Airflow","name":"xxxx","baseUrl":"http://xxxx:8080","username":"xx","password":"xxx","owner":"xx"}]
AIRFLOW_ACTIVE_SERVICE_ID=main
AIRFLOW_REQUEST_TIMEOUT_MS=60000
