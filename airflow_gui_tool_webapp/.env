# Lovito Task Hub SeaTalk WebApp

# HTTP server
HOST=127.0.0.1
PORT=7777
SESSION_SECRET=replace-with-a-long-random-string

# SeaTalk WebApp SSO. Required outside local development.
SEATALK_APP_ID=NTE5MzU1MDQxOTgw
SEATALK_APP_SECRET=w0XihUAXBjOtFC9oJxVc9Vh20lFJgWbl
SEATALK_API_BASE_URL=https://openapi.seatalk.io

# Comma-separated employee codes allowed to trigger DAGs, kill tasks, and pause/unpause DAGs.
SEATALK_ADMIN_EMPLOYEE_CODES=shaun.pan

# Local browser development fallback. Disable in production.
ALLOW_DEV_AUTH=false
DEV_USER_EMPLOYEE_CODE=shaun.pan
DEV_USER_EMAIL=shaun.pan@lovito.com
DEV_USER_NAME=Shaun Pan

# Airflow services. Passwords stay server-side and are never sent to the browser.
AIRFLOW_LIST=[{"id":"146","alias":"146 Airflow","name":"34.142.225.103","baseUrl":"http://34.142.225.103:8080","username":"shaun","password":"shaun2024","owner":"Shaun"},{"id":"main","alias":"146 Dup Airflow","name":"10.182.1.146","baseUrl":"http://10.182.1.146:8080","username":"shaun","password":"shaun2024","owner":"Shaun"},{"id":"177","alias":"177 Airflow","name":"34.142.170.164","baseUrl":"http://34.142.170.164:8080","username":"ayla","password":"ayla","owner":""}]
AIRFLOW_ACTIVE_SERVICE_ID=main
AIRFLOW_REQUEST_TIMEOUT_MS=60000
DAG_CONF_ENV_URL=https://raw.githubusercontent.com/XXXShaunPan/ScriptRepo/refs/heads/quick_matching_tool/airflow_gui_tool/.dag-conf.env

UPDATE_MANIFEST_URL=https://github.com/XXXShaunPan/ScriptRepo/releases/latest/download/update-manifest.json
UPDATE_CHECK_ON_START=true
UPDATE_CHECK_INTERVAL_HOURS=24
UPDATE_REQUEST_TIMEOUT_MS=8000

# Optional. Build-time GitHub release target for `npm run dist:all 1.0.3 --release`.
# If omitted, the release script tries to infer owner/repo from git remote.origin.url.
GITHUB_RELEASE_REPO=XXXShaunPan/ScriptRepo
